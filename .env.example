# URL pública do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://kwgkvxudhumqfvfxbdkw.supabase.co

# Chave pública (publishable). Pode ficar com NEXT_PUBLIC_ porque não é segredo.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=COLE_AQUI_SUA_CHAVE_PUBLISHABLE

# OBRIGATÓRIO no servidor (Vercel/Netlify/etc.).
# Pegue em Supabase > Settings > API > Secret key.
# NUNCA coloque esta chave em NEXT_PUBLIC_ e nunca envie para o navegador.
SUPABASE_SECRET_KEY=COLE_AQUI_A_SECRET_KEY_DO_SUPABASE

# Pode usar o mesmo segredo acima, mas é melhor definir um segredo exclusivo para a sessão do Admin.
ADMIN_SESSION_SECRET=COLOQUE_UMA_STRING_LONGA_E_ALEATORIA

# Compatibilidade com projetos que usam o nome antigo:
# SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_A_SERVICE_ROLE_KEY
